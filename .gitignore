# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# 삽화 원본(대용량 PNG). 서비스에는 public/ 의 WebP 를 쓴다
_originals/
